correlation_data <-
output_data %>%
inner_join(
inputs_cor,
by = "run_id"
)
# ==========================================================
# 3.3. Calcular Spearman para cada input
# ==========================================================
correlation_results <-
correlation_data %>%
group_by(
input_id
) %>%
summarise(
# ------------------------------------------------------
# Número de observaciones completas
# ------------------------------------------------------
n =
sum(
complete.cases(
logit,
error_abs
)
),
# ------------------------------------------------------
# Correlación Spearman
# ------------------------------------------------------
correlation = {
complete <-
complete.cases(
logit,
error_abs
)
x <-
logit[
complete
]
y <-
error_abs[
complete
]
if (
length(x) >= 3 &&
sd(x) > 0 &&
sd(y) > 0
) {
cor(

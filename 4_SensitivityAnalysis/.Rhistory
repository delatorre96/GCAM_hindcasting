select(run_id, input_id, logit )
correlation_list <- vector(
"list",
length(
all_errors_keys$output_id
)
)
for (i in seq_along(all_errors_keys$output_id)) {
output_id_i <-
all_errors_keys$output_id[i]
# ==========================================================
# 3.1. Seleccionar output
# ==========================================================

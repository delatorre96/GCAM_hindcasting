mutate(
output_id =
output_id_i
) %>%
select(
output_id,
input_id,
n,
correlation
)
# ==========================================================
# 3.4. Guardar resultado
# ==========================================================
correlation_list[[i]] <-
correlation_results
# ==========================================================
# 3.5. Progreso
# ==========================================================
if (
i %% 100 == 0 ||
i ==
length(
all_errors_keys$output_id
)
) {
cat(
"Output:",
i,
"/",
length(
all_errors_keys$output_id
),
"| Output ID:",
output_id_i,
"\n"
)
}
}
inputs_cor <- inputs_logits %>%
select(run_id, input_id, logit )
correlation_list <- vector(
"list",
length(
all_errors_keys$output_id
)
)
for (i in seq_along(all_errors_keys$output_id)) {
output_id_i <-
all_errors_keys$output_id[i]
# ==========================================================
# 3.1. Seleccionar output
# ==========================================================
output_data <- all_errors %>%
filter(
output_id == output_id_i
) %>%
select(
run_id,
error_abs
)
# ==========================================================
# 3.2. Join output con inputs
# ==========================================================
correlation_data <-
output_data %>%
inner_join(
inputs_cor,
by = "run_id"
)
# ==========================================================
# 3.3. Calcular Spearman para cada input
# ==========================================================
correlation_results <-
correlation_data %>%
group_by(
input_id
) %>%
summarise(
# ------------------------------------------------------
# Número de observaciones completas
# ------------------------------------------------------
n =
sum(
complete.cases(
logit,
error_abs
)
),
# ------------------------------------------------------
# Correlación Spearman
# ------------------------------------------------------
correlation = {
complete <-
complete.cases(
logit,
error_abs
)
x <-
logit[
complete
]
y <-
error_abs[
complete
]
if (
length(x) >= 3 &&
sd(x) > 0 &&
sd(y) > 0
) {
cor(
x,
y,
method = "spearman"
)
} else {
NA_real_
}
},
.groups = "drop"
) %>%
mutate(
output_id =
output_id_i
) %>%
select(
output_id,
input_id,
n,
correlation
)
# ==========================================================
# 3.4. Guardar resultado
# ==========================================================
correlation_list[[i]] <-
correlation_results
# ==========================================================
# 3.5. Progreso
# ==========================================================
if (
i %% 100 == 0 ||
i ==
length(
all_errors_keys$output_id
)
) {
cat(
"Output:",
i,
"/",
length(
all_errors_keys$output_id
),
"| Output ID:",
output_id_i,
"\n"
)
}
}
correlation_results
correlation_data
correlation_list
correlation_all <-
bind_rows(
correlation_list
)
View(correlation_all)
correlation_all
correlation_all <-
bind_rows(
correlation_list
) %>% mutate (corr_abs = abs(correlation))
input_correlation_summary <- correlation_all %>%
group_by(input_id) %>%
summarise(
max_abs_correlation =
max(
abs(correlation),
na.rm = TRUE
),
n_outputs_correlated =
sum(
abs(correlation) >= 0.1,
na.rm = TRUE
),
.groups = "drop"
)
View(input_correlation_summary)
